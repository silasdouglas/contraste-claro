  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#60656E", "fontStyle": "italic" } },
    { "scope": ["comment.block.documentation", "comment.block.javadoc"], "settings": { "foreground": "#5A6270", "fontStyle": "italic" } },
    { "scope": ["storage.type.class.jsdoc", "storage.type.class.doxygen", "keyword.other.phpdoc"], "settings": { "foreground": "#6A35B8", "fontStyle": "bold italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#B0105C" } },
    { "scope": ["keyword.control.flow", "keyword.control.return", "keyword.control.conditional", "keyword.control.loop", "keyword.control.trycatch", "keyword.control.import", "keyword.control.export", "keyword.control.from"], "settings": { "foreground": "#B0105C", "fontStyle": "bold" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#454B54" } },
    { "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.operator.word"], "settings": { "foreground": "#B0105C" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#17692B" } },
    { "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"], "settings": { "foreground": "#A33400" } },
    { "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"], "settings": { "foreground": "#B0105C" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"], "settings": { "foreground": "#6A35B8" } },
    { "scope": ["variable.other.constant", "variable.other.enummember"], "settings": { "foreground": "#6A35B8" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"], "settings": { "foreground": "#0A55A8" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.class", "support.type", "entity.name.namespace", "storage.type.primitive"], "settings": { "foreground": "#8A4600" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#1B1F24" } },
    { "scope": ["variable.parameter", "meta.parameter"], "settings": { "foreground": "#2F4A7A", "fontStyle": "italic" } },
    { "scope": ["variable.language.this", "variable.language.self", "variable.language.super"], "settings": { "foreground": "#B0105C", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "entity.name.tag.yaml", "support.type.property-name"], "settings": { "foreground": "#00636F" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#B0105C" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#8A4600" } },
    { "scope": ["entity.name.function.decorator", "meta.decorator", "punctuation.decorator", "storage.type.annotation"], "settings": { "foreground": "#A33400" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#0A55A8", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "markup.link"], "settings": { "foreground": "#0A55A8", "fontStyle": "underline" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#A33400" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "#60656E", "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#17692B" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#C0111F" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#995400" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FFFFFF", "background": "#C0111F" } },
    { "scope": ["invalid.deprecated"], "settings": { "foreground": "#995400", "fontStyle": "strikethrough" } }
  ],
  "semanticTokenColors": {
    "parameter": { "foreground": "#2F4A7A", "italic": true },
    "property": "#00636F",
    "enumMember": "#6A35B8",
    "variable.readonly": "#6A35B8",
    "variable.defaultLibrary": { "foreground": "#6A35B8" },
    "function.defaultLibrary": "#0A55A8",
    "type": "#8A4600",
    "class": "#8A4600",
    "interface": { "foreground": "#8A4600", "italic": true },
    "typeParameter": { "foreground": "#8A4600", "italic": true },
    "namespace": "#8A4600",
    "decorator": "#A33400",
    "*.deprecated": { "strikethrough": true }
  }
}
